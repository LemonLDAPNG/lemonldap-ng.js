{
  "name": "@lemonldap-ng/message-broker-web",
  "version": "0.9.4",
  "description": "HTTP/WebSocket message broker for LemonLDAP::NG handler",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "maintainers": [
    {
      "name": "Yadd",
      "email": "yadd@debian.org"
    }
  ],
  "homepage": "https://lemonldap-ng.org",
  "files": [
    "package.json",
    "lib",
    "LICENSE",
    "*.md"
  ],
  "dependencies": {
    "@lemonldap-ng/message-broker": "^0.9.3",
    "@lemonldap-ng/types": "^0.9.3"
  },
  "bugs": {
    "url": "https://gitlab.ow2.org/lemonldap-ng/lemonldap-ng/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LemonLDAPNG/lemonldap-ng.js.git"
  },
  "keywords": [
    "Lemonldap::NG",
    "SSO",
    "MessageBroker",
    "HTTP",
    "Web"
  ],
  "authors": [
    "Xavier Guimard <yadd@debian.org>"
  ],
  "license": "GPL-2.0-or-later",
  "llng-compat": "2.0.5",
  "scripts": {
    "test": "vitest run",
    "build": "rollup -c"
  }
