# sqlite3 >= 6 ships prebuilt N-API binaries linked against GLIBC 2.38.
# prebuild-install downloads them without checking the host GLIBC, so on older
# targets (Debian 12 bookworm 2.36, Ubuntu 22.04 2.35) the install succeeds and
# require() fails at runtime. Build it against the local libc instead.
# Scoped to sqlite3 only: prebuild-install matches this value against the
# package name (see its rc.js), so other native modules keep their prebuilds.
#
# npm warns "Unknown project config" here and says it will stop honouring
# unknown keys in its next major. If that happens, pass it as an environment
# variable instead: npm_config_build_from_source=sqlite3 npm ci
build_from_source=sqlite3
